{
  "expo": {
    "name": "देसी Aahhar",
    "slug": "desi-aahhar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/desi-aahhar-logo.png",
    "scheme": "desiaahhar",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/desi-aahhar-logo.png",
      "bundleIdentifier": "com.vid876.desiaahhar",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF9EC",
        "foregroundImage": "./assets/brand/desi-aahhar-logo.png",
        "monochromeImage": "./assets/brand/desi-aahhar-logo.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.vid876.desiaahhar"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9EC",
          "image": "./assets/brand/desi-aahhar-logo.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
