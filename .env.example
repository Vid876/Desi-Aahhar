# Local database
POSTGRES_DB=desiaahhar
POSTGRES_USER=desiaahhar
POSTGRES_PASSWORD=desiaahhar-local-password
POSTGRES_PORT=5433

# Application security (use a long random value in production)
JWT_SECRET=replace-with-at-least-32-random-characters-before-production
ADMIN_NAME=Desi Aahhar Admin
ADMIN_EMAIL=admin@desiaahhar.in
ADMIN_PASSWORD=Admin@123
STAFF_NAME=Ravi Delivery
STAFF_EMAIL=delivery@desiaahhar.in
STAFF_PASSWORD=Delivery@123

# Use your computer's LAN IP when testing from a physical phone
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Local OTP behavior. Phone OTP is 123456 until Twilio is configured.
DEV_OTP_CODE=123456
EXPOSE_DEV_OTP=true

# Twilio Verify (real SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Mailpit works automatically in Docker. Replace these for a real SMTP provider.
SMTP_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@desiaahhar.in

# Razorpay (real payment checkout is enabled only when both values are present)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Cloud Messaging (used by docker-compose.firebase.yml)
FIREBASE_PROJECT_ID=
